# ============================================================
# Unity .gitignore
# ============================================================

# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory Profiler Snapshots
/MemoryCaptures/

# Recordings
/[Rr]ecordings/

# Autogenerated VS/MD/Rider solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.ipa
*.xcarchive

# Crashlytics
crashlytics-build.properties
com_crashlytics_export_strings.xml

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# TextMeshPro
/[Aa]ssets/TextMesh Pro/Resources/Fonts & Materials/*.asset

# ============================================================
# IDE
# ============================================================
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# OS
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini

# ============================================================
# Devin / CI artifacts (don't commit)
# ============================================================
*.log

# Test build artifacts
Tests/**/bin/
Tests/**/obj/
Tests/**/TestResults/
